# Vercel Environment Variables
# Copy this file to .env.local after running 'vercel link'

# These values will be auto-filled by 'vercel env pull'
# For local development, you can set them manually

# Development Environment
STAGE=development
NODE_ENV=development
NUXT_DEVTOOLS=true
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Features
ENABLE_DEBUG_PANEL=true
ENABLE_ANALYTICS=true
ENABLE_PWA=false

# Add your API keys here (optional)
GOOGLE_ANALYTICS_ID=
VITE_APP_TOLGEE_API_KEY=