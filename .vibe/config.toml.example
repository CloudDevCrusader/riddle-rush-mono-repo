# Mistral Vibe Configuration Example
# This file shows how to configure Mistral Vibe with the Riddle Rush MCP export

# MCP Configuration
# Points to the enhanced MCP configuration generated by the export system
[mcp]
config_path = "~/.vibe/mcp-config.json"

# Agent Settings (optional)
# Configure the default agent behavior
[agent]
# model = "devstral-3"  # Default model to use
# temperature = 0.7      # Creativity level (0.0 - 1.0)
# max_tokens = 4096     # Maximum response length

# Tool Configuration (optional)
# Configure how tools are used
[tools]
# timeout = 30          # Tool execution timeout in seconds
# retries = 3          # Number of retry attempts for failed tools
# parallel = 5         # Maximum parallel tool executions

# Logging (optional)
# Configure logging behavior
[logging]
# level = "info"       # Log level: debug, info, warn, error
# file = "~/.vibe/vibe.log"  # Log file path

# Example usage with Riddle Rush MCP servers:
# After setting up, you can use servers like:
# - repo-primary-playwright-test (Playwright automation)
# - repo-fastmcp-nuxt (Nuxt.js documentation)
# - repo-cursor-aws-docs (AWS documentation)

# To list available servers:
# vibe list-servers

# To use a specific server:
# vibe use-server repo-fastmcp-nuxt

# For more information, see:
# - ENHANCED-MCP-EXPORT-GUIDE.md
# - https://riddle-rush.com/docs/mcp-integration
