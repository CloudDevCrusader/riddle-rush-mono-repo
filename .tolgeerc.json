{
  "$schema": "https://docs.tolgee.io/cli-schema.json",
  "projectId": 27759,
  "parser": "vue",
  "format": "JSON_TOLGEE",
  "patterns": ["./apps/game/**/*.ts|vue?(x)"],
  "push": {
    "filesTemplate": "./apps/game/translations/locales/{languageTag}.json",
    "language": ["de", "en"]
  },
  "pull": {
    "path": "./apps/game/translations/locales/"
  }
}
