# BunkerWeb Docker Compose Environment Variables
# Copy this file to .env and set your own values

# Database password (used by both BunkerWeb and MariaDB)
DB_PASSWORD=your_secure_password_here

# Admin credentials for the BunkerWeb UI
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# TOTP encryption secret (generate a strong random string)
# Example: openssl rand -hex 32
TOTP_SECRET=your_totp_secret_here