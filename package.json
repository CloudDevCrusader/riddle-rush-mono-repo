{
  "name": "riddle-rush-monorepo",
  "description": "Riddle Rush - Monorepo for game, documentation, and infrastructure",
  "version": "1.3.0",
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.63",
    "@changesets/cli": "^2.29.8",
    "@composio/claude-agent-sdk": "^0.6.3",
    "@composio/core": "^0.6.3",
    "@pnpm/filter-workspace-packages": "^1000.1.3",
    "@trigger.dev/sdk": "^4.4.1",
    "@types/node": "^25.3.3",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.2",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "knip": "^5.86.0",
    "lint-staged": "^16.3.1",
    "prettier": "^3.8.1",
    "syncpack": "^14.0.0",
    "turbo": "^2.8.12",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "private": true,
  "scripts": {
    "android:open": "cd apps/game && pnpm android:open",
    "android:run": "cd apps/game && pnpm android:run",
    "android:sync": "cd apps/game && pnpm android:sync",
    "build": "turbo run build --filter=@riddle-rush/game",
    "build:all": "turbo run build",
    "changeset": "changeset",
    "changeset:publish": "changeset publish",
    "changeset:version": "changeset version",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "version": "changeset version",
    "deploy:aws": "./scripts/aws-deploy.sh",
    "deploy:dev": "./scripts/deploy-dev.sh",
    "deploy:infrastructure": "./scripts/deploy-infrastructure.sh",
    "deploy:prod": "./scripts/deploy-prod.sh",
    "deploy:vercel:dev": "STAGE=development vercel",
    "deploy:vercel:prod": "STAGE=production vercel --prod",
    "deploy:vercel:preview": "vercel",
    "deploy:preview": "./scripts/deploy-preview.sh",
    "vercel:env:pull": "vercel env pull .env.local",
    "vercel:link": "vercel link",
    "dev": "turbo run dev --filter=@riddle-rush/game",
    "dev:all": "turbo run dev",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "generate": "turbo run generate --filter=@riddle-rush/game",
    "infra:fmt": "terraform fmt -recursive infrastructure/",
    "infra:fmt:check": "terraform fmt -recursive -check infrastructure/",
    "infra:validate:dev": "cd infrastructure/environments/development && terraform validate",
    "infra:validate:prod": "cd infrastructure/environments/production && terraform validate",
    "infra:dev:apply": "cd infrastructure/environments/development && terraform apply",
    "infra:dev:init": "cd infrastructure/environments/development && terraform init",
    "infra:dev:plan": "cd infrastructure/environments/development && terraform plan",
    "infra:prod:apply": "cd infrastructure/environments/production && terraform apply",
    "infra:prod:init": "cd infrastructure/environments/production && terraform init",
    "infra:prod:plan": "cd infrastructure/environments/production && terraform plan",
    "infra:translation:apply": "cd infrastructure/environments/translation && terraform apply",
    "infra:translation:init": "cd infrastructure/environments/translation && terraform init",
    "infra:translation:plan": "cd infrastructure/environments/translation && terraform plan",
    "infra:validate:translation": "cd infrastructure/environments/translation && terraform validate",
    "infra:setup": "cd infrastructure && ./scripts/setup-tfenv.sh",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "playwright:docker": "./scripts/playwright-docker.sh",
    "prepare": "husky",
    "syncpack:check": "syncpack lint",
    "syncpack:fix": "syncpack fix",
    "syncpack:format": "syncpack format",
    "terraform:apply": "./scripts/terraform-apply.sh",
    "terraform:outputs": "./scripts/get-terraform-outputs.sh",
    "terraform:plan": "./scripts/terraform-plan.sh",
    "terraform:sync": "./scripts/sync-terraform-outputs.sh",
    "test": "turbo run test --filter=@riddle-rush/game",
    "test:e2e": "turbo run test:e2e --filter=@riddle-rush/game",
    "test:e2e:ui": "turbo run test:e2e --filter=@riddle-rush/game --ui web",
    "test:e2e:docker": "./scripts/e2e-docker.sh",
    "test:unit": "turbo run test:unit",
    "typecheck": "turbo run typecheck",
    "knip": "knip --reporter compact",
    "workspace:check": "pnpm syncpack:check && pnpm typecheck && pnpm lint",
    "workspace:fix": "pnpm syncpack:fix && pnpm lint:fix && pnpm format",
    "agent": "node scripts/agent-cli.js",
    "agent:help": "bash scripts/agent-commands.sh",
    "agent:status": "bash scripts/agent-status.sh",
    "agent:validate": "bash scripts/agent-validate.sh",
    "agent:fix": "bash scripts/agent-autofix.sh",
    "agent:check": "pnpm run workspace:check",
    "agent:commit": "pnpm run agent:validate && git add . && echo 'Ready to commit! Run: git commit -m \"type: message\"'",
    "maintain": "pnpm update && pnpm run syncpack:fix && pnpm run workspace:check",
    "validate:locales": "node scripts/validate-locales.mjs",
    "i18n:start": "pnpm --filter @riddle-rush/tolgee start",
    "i18n:stop": "pnpm --filter @riddle-rush/tolgee stop",
    "i18n:push": "pnpm --filter @riddle-rush/tolgee push",
    "i18n:pull": "pnpm --filter @riddle-rush/tolgee pull",
    "python:lint": "bash scripts/python-lint.sh",
    "python:format": "bash scripts/python-format.sh",
    "python:check": "pnpm run python:lint",
    "trunk:eslint": "bash scripts/trunk-eslint.sh",
    "trunk:prettier": "bash scripts/trunk-prettier.sh",
    "trunk:check": "./.trunk-cache/cli/1.25.0-linux-x86_64/trunk check --all",
    "trunk:fmt": "./.trunk-cache/cli/1.25.0-linux-x86_64/trunk fmt --all",
    "ai:status": "python tools/ai-agents/agent-tools.py",
    "ai:agents": "cd tools/python && python main.py",
    "ai:tools": "python tools/ai-agents/agent-tools.py"
  },
  "type": "module",
  "bin": {
    "riddlerush": "./bin/run.js"
  },
  "oclif": {
    "bin": "riddlerush",
    "commands": "./dist/commands",
    "dirname": "riddlerush",
    "topicSeparator": " "
  },
  "dependencies": {
    "@e2b/code-interpreter": "^2.4.0",
    "@langchain/openai": "^1.3.0",
    "@voltagent/core": "^2.6.12",
    "@voltagent/mcp-server": "^2.0.2",
    "ai": "^6.0.137",
    "langchain": "^1.2.28",
    "zod": "^4.3.6"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "10",
        "@pnpm/logger": ">=3",
        "citty": ">=0.2",
        "zod": ">=4",
        "dotenv": ">=17"
      }
    }
  }
}
