    "onlyBuiltDependencies": [
      "appium",
      "appium-ios-tuntap",
      "better-sqlite3",
      "core-js-pure",
      "edgedriver",
      "esbuild",
      "geckodriver",
      "protobufjs",
      "yarn"
    ],
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "cwebp-bin",
      "gifsicle",
      "jpegtran-bin",
      "mozjpeg",
      "optipng-bin",
      "pngquant-bin",
      "sharp",
      "unrs-resolver",
      "vue-demi"
    ]
