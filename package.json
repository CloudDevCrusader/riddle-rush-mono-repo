    "@composio/claude-agent-sdk": "^0.9.2",
    "@composio/core": "^0.10.0",
    "@pnpm/filter-workspace-packages": "^1000.1.6",
    "@trigger.dev/sdk": "^4.4.6",
    "@types/node": "^25.9.0",
    "@vercel/edge-config": "^1.4.3",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "knip": "^5.88.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "stylelint": "^17.11.1",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "syncpack": "^14.3.1",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "oclif": {
    "bin": "riddlerush",
    "commands": "./dist/commands",
    "dirname": "riddlerush",
    "topicSeparator": " "
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "10",
        "@pnpm/logger": ">=3",
        "citty": ">=0.2",
        "zod": ">=4",
        "dotenv": ">=17"
      }
    },
    "overrides": {
      "hono@<4.12.4": "^4.12.4",
      "immutable@>=5.0.0 <5.1.5": "^5.1.5",
      "@hono/node-server@<1.19.10": "^1.19.10",
      "express-rate-limit@>=8.2.0 <8.2.2": "^8.2.2",
      "file-type@>=13.0.0 <21.3.1": "^21.3.1",
      "hono@<4.12.7": "^4.12.7",
      "yauzl@=3.2.0": "^3.2.1",
      "h3@>=2.0.0 <=2.0.1-rc.14": "^2.0.1-rc.15",
      "flatted@<=3.4.1": "^3.4.2",
      "fast-xml-parser@>=4.0.0-beta.3 <=5.5.6": "^5.5.7",
      "h3@>=2.0.0-beta.0 <=2.0.1-rc.16": "^2.0.1-rc.17",
      "h3@>=2.0.1-alpha.0 <=2.0.1-rc.16": "^2.0.1-rc.17",
      "fast-xml-parser@>=4.0.0-beta.3 <=5.5.5": "^5.5.6",
      "h3@>=2.0.0-0 <2.0.1-rc.15": "^2.0.1-rc.15",
      "h3@>=2.0.0-beta.4 <2.0.1-rc.18": "^2.0.1-rc.18",
      "got@<11.8.5": "^11.8.5",
      "semver-regex@<3.1.3": "^3.1.3",
      "semver-regex@<3.1.4": "^3.1.4",
      "electron@<22.3.19": "^22.3.19",
      "electron@<22.3.6": "^22.3.6",
      "trim-newlines@<3.0.1": "^3.0.1",
      "electron@<22.3.25": "^22.3.25",
