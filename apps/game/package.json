    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "@vueuse/motion": "^3.0.3",
    "eslint": "^10.1.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.8.4",
    "nuxt-security": "^2.5.1",
    "parcel-codegen-loader": "^2.1.0",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "typescript": "^5.9.3",
    "unocss": "^66.6.7",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite-plugin-browserslist-useragent": "^0.7.0",
    "vite-plugin-checker": "^0.12.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-dynamic-prefetch": "^0.1.5",
    "vite-plugin-imagemin": "^0.6.1",
    "vite-plugin-inspect": "^11.3.3",
    "vite-plugin-vue-devtools": "^8.1.0",
    "vite-plugin-vue-inspector": "^5.4.0",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.6",
    "zod": "^4.3.6"
  },
  "packageManager": "pnpm@10.30.3",
  "private": true,
  "scripts": {
    "android:build": "pnpm android:sync && npx cap copy android && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android",
    "android:sync": "pnpm build && npx cap sync android",
    "build": "nuxt build",
    "build:debug": "nuxt build --debug",
    "capacitor:copy": "npx cap copy",
    "capacitor:sync": "pnpm build && npx cap sync",
    "clean": "rm -rf .nuxt .output node_modules",
    "dev": "nuxt dev",
    "dev:debug": "nuxt dev --debug",
    "dev:https": "nuxt dev --https",
    "dev:mobile": "nuxt dev --host 0.0.0.0",
    "dev:mobile-https": "nuxt dev --https --host 0.0.0.0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "nuxt generate",
    "generate:debug": "nuxt generate --debug",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "nuxt:ui": "nuxt ui",
    "postinstall": "nuxt prepare && (test -f .nuxt/pwa-icons-plugin.ts && { echo '// @ts-nocheck' | cat - .nuxt/pwa-icons-plugin.ts > .nuxt/pwa-icons-plugin.tmp && mv .nuxt/pwa-icons-plugin.tmp .nuxt/pwa-icons-plugin.ts; } || true) && (npx sharp --version >/dev/null 2>&1 || echo 'Sharp binaries installed successfully') || true",
    "preview": "nuxt preview",
    "preview:https": "nuxt preview --https",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:simple": "playwright test --config=playwright.simple.config.ts",
    "test:bdd": "bddgen && playwright test",
    "test:bdd:headed": "bddgen && playwright test --headed",
    "test:bdd:generate": "bddgen",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "typecheck": "bash scripts/typecheck.sh"
  },
  "type": "module"
}
