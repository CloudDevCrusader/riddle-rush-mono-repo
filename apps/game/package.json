    "vue-router": "^5.0.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@capacitor/android": "^8.2.0",
    "@faker-js/faker": "^10.3.0",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/image": "^2.0.0",
    "@nuxt/test-utils": "^4.0.0",
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/device": "^4.0.0",
    "@nuxtjs/fontaine": "^0.5.0",
    "@playwright/test": "^1.58.2",
    "@tolgee/vue": "^6.6.0",
    "@types/lodash-es": "^4.17.12",
