    "@vueuse/motion": "^3.0.3",
    "eslint": "^10.2.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.8.9",
    "nuxt-security": "^2.5.1",
    "parcel-codegen-loader": "^2.1.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "unlighthouse": "^0.17.7",
    "unocss": "^66.6.8",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.1.0",
    "vite-plugin-browserslist-useragent": "^0.7.0",
    "vite-plugin-checker": "^0.12.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-dynamic-prefetch": "^0.1.5",
    "vite-plugin-imagemin": "^0.6.1",
    "vite-plugin-inspect": "^11.3.3",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vite-plugin-vue-inspector": "^5.4.0",
    "vitest": "^4.1.2",
    "vue-tsc": "^3.2.6",
    "zod": "^4.3.6"
  },
  "packageManager": "pnpm@10.30.3",
  "private": true,
  "scripts": {
    "build": "npx nuxt build",
    "build:debug": "DEBUG_BUILD=true npx nuxt build",
    "clean": "rm -rf .nuxt .output node_modules",
    "dev": "npx nuxt dev",
    "dev:debug": "npx nuxt dev --debug",
    "dev:https": "npx nuxt dev --https",
    "dev:mobile": "npx nuxt dev --host 0.0.0.0",
    "dev:mobile-https": "npx nuxt dev --https --host 0.0.0.0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "npx nuxt generate",
    "generate:debug": "DEBUG_BUILD=true npx nuxt generate",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "assets:verify": "node -e \"const fs=require('fs');const path='public/assets';const walk=(d)=>fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(d+'/'+e.name):[d+'/'+e.name]);const png=walk(path).filter(f=>f.endsWith('.png'));const missing=png.filter(f=>!fs.existsSync(f.replace(/.png$/,'.webp')));if(missing.length){console.error('Missing .webp for:\\n'+missing.join('\\n'));process.exit(1)}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lighthouse": "unlighthouse --site http://localhost:3000 --output-path .lighthouse --enable-javascript",
    "lighthouse:ci": "unlighthouse-ci --site http://localhost:3000 --output-path .lighthouse-ci --reporter jsonExpanded --enable-javascript",
    "nuxt:ui": "npx nuxt ui",
    "postinstall": "npx nuxt prepare && (test -f .nuxt/pwa-icons-plugin.ts && { echo '// @ts-nocheck' | cat - .nuxt/pwa-icons-plugin.ts > .nuxt/pwa-icons-plugin.tmp && mv .nuxt/pwa-icons-plugin.tmp .nuxt/pwa-icons-plugin.ts; } || true) && (npx sharp --version >/dev/null 2>&1 || echo 'Sharp binaries installed successfully') || true",
    "preview": "npx nuxt preview",
    "preview:https": "npx nuxt preview --https",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:simple": "playwright test --config=playwright.simple.config.ts",
    "test:bdd": "bddgen && playwright test",
    "test:bdd:headed": "bddgen && playwright test --headed",
    "test:bdd:generate": "bddgen",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "typecheck": "bash scripts/typecheck.sh"
  },
  "type": "module"
}
