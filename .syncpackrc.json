{
  "source": ["package.json", "apps/*/package.json", "packages/*/package.json"],
  "semverGroups": [
    {
      "label": "Use exact versions for workspace packages",
      "packages": ["**"],
      "dependencies": ["@riddle-rush/**"],
      "range": ""
    },
    {
      "label": "Allow any range for pnpm overrides (security patches)",
      "packages": ["**"],
      "dependencies": ["**"],
      "dependencyTypes": ["pnpmOverrides"],
      "isIgnored": true
    },
    {
      "label": "Use caret for other dependencies",
      "packages": ["**"],
      "dependencies": ["**"],
      "range": "^"
    }
  ],
  "versionGroups": [
    {
      "label": "Keep workspace packages in sync",
      "packages": ["**"],
      "dependencies": ["@riddle-rush/**"]
    }
  ]
}
