# Development Environment Variables
# Copy this to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars to version control

project_name = "riddle-rush-pwa"
aws_region   = "eu-central-1"

# Leave empty for auto-generated name (will be: riddle-rush-pwa-development)
bucket_name = ""

# Development custom domain
domain_names    = ["dev.riddlerush.de"]
certificate_arn = "arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/CERTIFICATE_ID"

cloudfront_price_class = "PriceClass_100"
